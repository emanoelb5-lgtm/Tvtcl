<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <application>
        <activity android:name="com.b5solucoes.tcllight.MediaFixtureActivity" android:label="Busca e mídia de teste"
            android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.b5solucoes.tcllight.FixtureActivity"
            android:label="Arquivos de teste" android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
